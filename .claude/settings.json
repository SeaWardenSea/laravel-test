{
    "permissions": {
        "allow": [
            "Bash(composer check)",
            "Bash(vendor/bin/pest:*)",
            "Bash(vendor/bin/pint:*)",
            "Bash(vendor/bin/phpstan:*)",
            "Bash(git status)",
            "Bash(git diff:*)",
            "mcp__laravel-boost"
        ],
        "ask": [
            "Bash(git push:*)",
            "Bash(git commit:*)",
            "Bash(composer require:*)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.*)",
            "Bash(rm -rf:*)",
            "Bash(php artisan migrate:fresh:*)"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                    "type": "command",
                    "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check.sh"
                    }
                ]
            }
        ]
    }
}
